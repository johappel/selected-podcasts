    "audio": "https://wdrmedien-a.akamaihd.net/media/p/public/weltweit/2026/11/05/4e28cb5e-3e8b-461f-a6fe-db110e6a757c/4e28cb5e-3e8b-461f-a6fe-db110e6a757c_MP3-128.mp3",
